# ==============================================================
#  ACTIVE SITE — change this ONE line to switch to a different
#  SharePoint site / deployment.
#
#  Value must match the PREFIX used in the site blocks below.
#  Examples: local | dev | prod | nissenkaiun_sg | nissenkaiun_jp
# ==============================================================
ACTIVE_SITE=

# (legacy alias — still works; ACTIVE_SITE takes priority)
APP_ENV=
ALLOWED_ORIGINS=
# ==============================================================
#  LOCAL  (developer machine — kamalnathqatestergmail tenant)
# ==============================================================
LOCAL_AZURE_TENANT_ID=
LOCAL_GRAPH_CLIENT_ID=
LOCAL_GRAPH_CLIENT_SECRET=
LOCAL_SHAREPOINT_SITE_URL=

LOCAL_DRIVE_ID=

LOCAL_DB_HOST=
LOCAL_DB_PORT=
LOCAL_DB_NAME=
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=

LOCAL_ALLOWED_ORIGINS=
LOCAL_ADMIN_EMAILS=

LOCAL_GRAPH_SENDER_MAILBOX=
LOCAL_AI_BANTO_RECIPIENT=

# ==============================================================
#  DEV  (nk-dms-dev.sg-nissenkaiun.com)
# ==============================================================
DEV_AZURE_TENANT_ID=
DEV_GRAPH_CLIENT_ID=
DEV_GRAPH_CLIENT_SECRET=
DEV_SHAREPOINT_SITE_URL=

DEV_DRIVE_ID=

DEV_DB_HOST=
DEV_DB_PORT=
DEV_DB_NAME=
DEV_DB_USER=
DEV_DB_PASSWORD=

DEV_ALLOWED_ORIGINS=
DEV_ADMIN_EMAILS=

DEV_GRAPH_SENDER_MAILBOX=
DEV_AI_BANTO_RECIPIENT=

# ==============================================================
#  PROD  (sg-nissenkaiun.com)
# ==============================================================
PROD_AZURE_TENANT_ID=
PROD_GRAPH_CLIENT_ID=
PROD_GRAPH_CLIENT_SECRET=

PROD_DRIVE_ID=

PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=

PROD_ALLOWED_ORIGINS=
PROD_ADMIN_EMAILS=

PROD_GRAPH_SENDER_MAILBOX=
PROD_AI_BANTO_RECIPIENT=

# ==============================================================
#  SHARED (same across all environments)
# ==============================================================
MONTH_FOLDER_FORMAT=
GRAPH_VERIFY_SSL=
TRUSTED_PROXY_HOPS=
SESSION_IDLE_TIMEOUT_MINUTES=
SESSION_MAX_LIFETIME_HOURS=
SESSION_REVALIDATION_INTERVAL_MINUTES=

# --- Migration Assistant (credentials come from the DMS settings above) ---
# Source site for the same-site "Migration Assistant" tab
MIGRATION_SITE_HOSTNAME=
MIGRATION_SITE_PATH=
# Root folder (destination library) holding one folder per vessel
MIGRATION_DESTINATION_ROOT=
MIGRATION_DESTINATION_SITE_KEY=
MIGRATION_TEMPLATE_VESSEL_NAME=
# Tenant root URL, e.g. https://contoso.sharepoint.com (Managed Metadata writes)
MIGRATION_SHAREPOINT_TENANT_URL=
# Extra Site-to-Site sites not in Site Management, JSON:
# [{"key":"x","label":"X","hostname":"contoso.sharepoint.com","site_path":"sites/X"}]
MIGRATION_ALLOWED_SITES=
# Managed Metadata columns (internal field name + term set id)
MIGRATION_GROUP_FIELD_NAME=
MIGRATION_GROUP_TERM_SET_ID=
MIGRATION_CATEGORY_FIELD_NAME=
MIGRATION_CATEGORY_TERM_SET_ID=
MIGRATION_SUBCATEGORY_FIELD_NAME=
MIGRATION_SUBCATEGORY_TERM_SET_ID=
MIGRATION_VESSEL_FIELD_NAME=
MIGRATION_VESSEL_TERM_SET_ID=

# --- Documents Copilot (no external/free AI; see app/copilot/config.py) ---
# SharePoint Copilot agent link (empty = Microsoft 365 Copilot chat)
COPILOT_M365_URL=
# Company Azure OpenAI, only if approved by IT
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
