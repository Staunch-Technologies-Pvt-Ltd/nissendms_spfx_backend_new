# Migration Assistant settings (merged into the DMS backend).
# Copy to backend/.env.migration  (same folder as the DMS .env) and fill in.
# You can simply COPY your old standalone C:\llm\llm\SharePoint-AI-Migration-Assistant\.env
# to backend\.env.migration — the original un-prefixed names below are read as-is.
# (Real process env vars must be prefixed MIGRATION_, e.g. MIGRATION_GRAPH_CLIENT_SECRET.)
# ALLOWED_ORIGINS is no longer used — CORS is handled by the main DMS backend.
# DATABASE_URL defaults to backend/migration_assistant.db (own store, never the DMS Postgres).
#
# --- Microsoft Entra app registration (app-only / client-credentials) ---
# Needs the Sites.Selected Graph application permission, granted admin consent,
# and the site below shared with this app via the Sites.Selected site-permission
# API (see README.md "Graph API configuration").
AZURE_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Source SharePoint Online site to migrate documents out of ---
SITE_HOSTNAME=contoso.sharepoint.com
SITE_PATH=sites/VesselDocs

# --- Destination: root folder holding one subfolder per vessel ---
DESTINATION_ROOT=Technical and Crewing
TO_BE_CLASSIFIED_FOLDER_NAME=To Be Classified

# --- Classification (deterministic keyword matching — no LLM) ---
CONFIDENCE_THRESHOLD=0.75

# --- Database (SQLite by default — no setup needed) ---
# DATABASE_URL=sqlite:///./migration_assistant.db   (leave unset to use the default)

# --- Only set this to false if you hit CERTIFICATE_VERIFY_FAILED behind a
# corporate TLS-intercepting proxy and truststore isn't picking up your CA ---
GRAPH_VERIFY_SSL=true

# --- Same-site migration: source tag used to choose the destination folder ---
# This is the SharePoint internal column name. A tag matching an existing
# destination folder path/name takes precedence over text classification.
SOURCE_CATEGORY_FIELD_NAME=Category

# --- Site-to-Site migration: quick-pick sites shown in the source/destination
# site pickers. Optional — any other site can also be found by name (needs the
# Sites.Read.All application permission) or by pasting its URL. Whichever way
# a site is picked, the app must be granted access to it: Sites.Selected
# "read" to copy from it, "write" to copy into it, and "fullcontrol" on the
# destination for the "copy unique permissions" option. Each entry must already be granted Sites.Selected access (both
# under the Microsoft Graph AND the SharePoint API permissions — see README
# "Graph API configuration") before it's worth adding here. JSON array:
# [{"key":"technical-crewing","label":"Technical & Crewing","hostname":"contoso.sharepoint.com","site_path":"sites/TechnicalCrewing"},
#  {"key":"new-site","label":"New Site","hostname":"contoso.sharepoint.com","site_path":"sites/NewSite"}]
ALLOWED_SITES=[]

# --- Site-to-Site migration: tenant root SharePoint URL, used only to
# request the second (SharePoint REST, not Graph) app-only token that
# Managed Metadata field writes require — see graph/sharepoint_rest.py ---
SHAREPOINT_TENANT_URL=https://contoso.sharepoint.com
